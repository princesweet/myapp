// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  emailVerified     DateTime?
  passwordHash      String?
  image             String?
  role              String   @default("user")
  isPro             Boolean  @default(false)
  subscriptionPlan  String?  @default("free")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  predictions       Prediction[]
  betCodes          BetCode[]
  expertProfile     ExpertProfile?
  quotaEvents       QuotaEvent[]
  analyticsEvents   AnalyticsEvent[]
  posts             Post[]
  comments          Comment[]
  following         Follow[] @relation("follower")
  followers         Follow[] @relation("expert")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?     @map("expires_at")
  token_type        String?  @map("token_type")
  scope             String?
  id_token          String?  @map("id_token")
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prediction {
  id           String   @id @default(cuid())
  userId       String?
  sport        Sport
  providerKey  String
  inputJson    Json
  outputJson   Json
  confidence   Float
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  betCodes BetCode[]

  @@index([userId])
  @@index([providerKey])
}

model BetCode {
  id           String   @id @default(cuid())
  code         String   @unique
  providerKey  String
  sport        Sport
  selections   Json
  oddsDecimal  Float?
  isLive       Boolean  @default(false)
  status       BetStatus @default(GENERATED)
  userId       String?
  predictionId String?
  externalUrl  String?
  alias        String?
  createdAt    DateTime @default(now())

  user        User?       @relation(fields: [userId], references: [id])
  prediction  Prediction? @relation(fields: [predictionId], references: [id])
  analytics   AnalyticsEvent[]
  expertPicks ExpertPick[]
  posts       Post[]

  @@index([userId])
  @@index([providerKey])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        AnalyticsType
  betCodeId   String?
  userId      String?
  referrer    String?
  deviceType  String?
  userAgent   String?
  ip          String?
  country     String?
  createdAt   DateTime @default(now())

  betCode BetCode? @relation(fields: [betCodeId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([betCodeId])
  @@index([userId])
}

model ExpertProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  bio         String?
  verified    Boolean @default(false)
  winRate     Float   @default(0)
  picksCount  Int     @default(0)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks ExpertPick[]
}

model ExpertPick {
  id           String   @id @default(cuid())
  expertId     String
  betCodeId    String
  verified     Boolean  @default(false)
  result       PickResult @default(PENDING)
  createdAt    DateTime @default(now())

  expert  ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  betCode BetCode       @relation(fields: [betCodeId], references: [id], onDelete: Cascade)

  @@index([expertId])
  @@index([betCodeId])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  expertId    String
  createdAt   DateTime @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  expert   User @relation("expert", fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([followerId, expertId])
}

model LiveScore {
  id         String   @id @default(cuid())
  sport      Sport
  league     String?
  matchId    String   @unique
  homeTeam   String
  awayTeam   String
  startTime  DateTime
  status     String
  homeScore  Int      @default(0)
  awayScore  Int      @default(0)
  continent  String?
  country    String?
  updatedAt  DateTime @updatedAt
}

model Player {
  id          String   @id @default(cuid())
  externalId  String?  @unique
  name        String
  sport       Sport
  age         Int?
  nationality String?
  team        String?
  stats       Json?
  bio         Json?
  lastUpdated DateTime @default(now())

  @@index([name])
}

model QuotaEvent {
  id        String   @id @default(cuid())
  userId    String
  type      QuotaType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  betCodeId String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  betCode BetCode? @relation(fields: [betCodeId], references: [id])
  comments Comment[]

  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

enum Sport {
  FOOTBALL
  TENNIS
  BASKETBALL
  ATHLETICS
  F1
  GOLF
  BOXING
  DARTS
}

enum BetStatus {
  GENERATED
  PLACED
  WON
  LOST
  VOID
}

enum PickResult {
  PENDING
  WON
  LOST
}

enum AnalyticsType {
  CODE_GENERATED
  CODE_VIEWED
  STATS_VIEWED
  DASHBOARD_VIEWED
}

enum QuotaType {
  CODE_GENERATION
}
